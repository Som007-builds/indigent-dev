  "cards": [
    {
      "dot": "cyan",
      "title": "Ownership and the gate",
      "items": [
        "Soham owns mechanisms, Joy owns intelligence; JOY_MODULES switches with no try-import fallback",
        "LLM output never authorizes a tool call; the runtime re-checks the allow-list",
        "The sandbox runs network-disabled in both local and groq mode",
        "No Docker means SANDBOX_UNAVAILABLE, never a host subprocess"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence and exposure",
      "items": [
        "The API binds 127.0.0.1 and every response carries X-Inference-Mode",
        "audit_log is append-only, guarded by triggers that abort UPDATE and DELETE",
        "Any external call in local mode reports AIR-GAP VIOLATED, never AIR-GAPPED"
      ]
    }
  ]
