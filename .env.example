INFERENCE_MODE=local
LOCAL_HARDWARE_PROFILE=mac_silicon
GROQ_API_KEY=
JOY_MODULES=real
# JSON array of explicit ModelInventoryRecord objects; required by the real model layer.
# Leave blank in stub mode. Never populate model IDs or memory estimates by guessing.
MODEL_INVENTORY_JSON=
RESOURCE_MAX_CONCURRENCY=1
# Optional explicit hardware budgets in MB. Leave blank to measure this machine for real.
# Set only when the allocation is genuinely known (e.g. a headless runner with a fixed limit).
HARDWARE_RAM_BUDGET_MB=
HARDWARE_VRAM_BUDGET_MB=
# Production RAG uses only an operator-provisioned local Ollama embedding model.
# EMBEDDING_MODEL must match a `name` from GET /api/tags exactly (include the
# ":latest" tag if the model has one); the adapter never pulls a missing model.
# EMBEDDING_VECTOR_SIZE must be that model's real output dimension.
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=<operator-provisioned-local-model>
EMBEDDING_VECTOR_SIZE=<model-specific-dimension>
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
MAX_UPLOAD_MB=50
MAX_PID_IMAGE_MB=25
MAX_MESSAGE_CHARS=20000
MAX_ACTIVE_TASKS=2
PER_TOOL_TIMEOUT_S=30
MODEL_GENERATION_TIMEOUT_S=60
HARD_TASK_TIMEOUT_S=300
APPROVAL_TIMEOUT_S=86400
PID_TIMEOUT_S=120
SANDBOX_IMAGE=indigent-sandbox:1
SANDBOX_MEM_MB=256
SANDBOX_CPUS=1
SANDBOX_PIDS=64
SANDBOX_OUTPUT_LIMIT_KB=64
WORKSPACE_TTL_HOURS=24
LOG_LEVEL=INFO
